# Production env for the Docker stack — copy to `.env.prod` ON THE SERVER and fill in.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# `.env.prod` is gitignored (`.env*`) and excluded from the Docker build context (.dockerignore).
# Do NOT quote values: compose passes them through literally, so "abc" would become part of the
# password. Never put a `$` in a value unless you escape it as `$$` (compose interpolates it).

########## Secrets ##############################################################################
# openssl rand -base64 32
PGPASSWORD=CHANGE_ME_db_password
# openssl rand -base64 32 — rotating this invalidates every session.
NEXTAUTH_SECRET=CHANGE_ME_auth_secret
AUTH_SECRET=CHANGE_ME_auth_secret

########## Public URLs ##########################################################################
# The origin the browser will use. Baked into the client bundle at BUILD time — after changing it
# you must rebuild (`up -d --build`), a restart is not enough.
# HTTPS via sslip.io (no domain needed): dashes for the dots of your server IP.
#   NEXT_PUBLIC_APP_URL=https://203-0-113-7.sslip.io
#   NEXT_PUBLIC_WS_URL=wss://203-0-113-7.sslip.io
# Plain HTTP while bootstrapping (before certbot):
#   NEXT_PUBLIC_APP_URL=http://203.0.113.7
#   NEXT_PUBLIC_WS_URL=ws://203.0.113.7
NEXT_PUBLIC_APP_URL=http://CHANGE_ME
NEXT_PUBLIC_WS_URL=ws://CHANGE_ME

# NextAuth's own base URL — same origin as NEXT_PUBLIC_APP_URL, read at RUNTIME (no rebuild).
NEXTAUTH_URL=http://CHANGE_ME

########## Nginx ################################################################################
# app-http.conf while bootstrapping; switch to app-ssl.conf after the certificate is issued
# (and put your host name into deployment/nginx/app-ssl.conf first).
NGINX_CONF=app-http.conf

########## Database #############################################################################
# DATABASE_URL is assembled by docker-compose.prod.yaml from these — do not set it here.
POSTGRES_USER=warsworld
POSTGRES_DB=warsworld

########## OAuth (optional) #####################################################################
# Callback URL to register with each provider: <NEXT_PUBLIC_APP_URL>/api/auth/callback/<provider>
# Leave a pair empty and that provider is simply not offered (see src/pages/api/authOptions.ts).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

########## Logging ##############################################################################
# One of: debug | info | warn | error | silent. Defaults to warn in production.
LOG_LEVEL=info
# Browser-side level — build-time, like the other NEXT_PUBLIC_* vars.
NEXT_PUBLIC_LOG_LEVEL=warn

########## Danger zone ##########################################################################
# Leave unset in production. It is the only way dev/admin tools can touch RANKED matches — no role
# overrides it, so an unset value keeps the ladder safe even from a stolen staff account.
# DEV_TOOLS_ALLOW_RANKED=true
