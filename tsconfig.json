{
  "compilerOptions": {
    "paths": {
      "shared/*": ["shared/*"]
    },
    "target": "esnext",

    "outDir": "dist",
    "lib": ["dom", "dom.iterable", "esnext"],

    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": "./src",
    "incremental": true,
    "downlevelIteration": true
  },

  "include": [".", ".eslintrc.cjs"], // .eslintrc.json is extra because the leading period makes it excluded otherwise
  // Build/tooling scripts run standalone under plain Node, outside the app's module graph — with
  // "checkJs" on they'd otherwise be type-checked as app source.
  "exclude": ["node_modules", "dist", ".next", "bundleServer.mjs", "prisma/scripts/migrations.mjs"]
}
