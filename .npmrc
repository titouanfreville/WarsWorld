# The dependency tree has one unresolvable peer conflict: `@auth/core@0.24` declares
# `nodemailer@^6`, while `next-auth@4.24` declares `nodemailer@^7`. Both are peerOptional and
# nodemailer is only pulled in if email auth is configured, so the conflict is inert at runtime —
# but npm 10 refuses to resolve it and fails outright.
#
# Without this file, behaviour depends on which npm you happen to run: recent npm (11.x) resolves it
# silently, npm 10 (Docker images, CI runners) errors with ERESOLVE. That difference is exactly why
# `package-lock.json` drifted out of sync and `npm ci` broke in Docker while working locally.
#
# Setting it here makes local, CI and the production image agree. Remove it once @auth/core and
# next-auth converge on the same nodemailer major.
legacy-peer-deps=true
