// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
  // NOTE: no `shadowDatabaseUrl` here on purpose. `migrate diff --from-migrations` ignores it and
  // requires the explicit --shadow-database-url flag anyway (the tooling scripts pass it), while
  // declaring it would make production depend on an env var it has no use for.
}

generator client {
  provider      = "prisma-client-js"
  // `debian-openssl-3.0.x` is what the production image needs — it runs on node:22-bookworm-slim
  // (Debian 12, glibc). Without it Prisma fails at container start with "query engine not found",
  // which reads like a build problem rather than a missing engine binary.
  // `linux-musl-openssl-3.0.x` is kept for Alpine-based images.
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

generator json {
  provider = "prisma-json-types-generator"
}

model Article {
  id          Int              @id @default(autoincrement())
  Authors     ArticleAuthors[]
  title       String
  description String
  category    ArticleCategory
  thumbnail   String?
  body        String
  Comments    ArticleComment[]

  // To return `Date`s intact through the API we need to add data transformers
  // https://trpc.io/docs/data-transformers
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model ArticleAuthors {
  article   Article @relation(fields: [articleId], references: [id])
  articleId Int
  author    Player  @relation(fields: [authorId], references: [id])
  authorId  String

  @@id([articleId, authorId])
}

model ArticleComment {
  id        String   @id @default(cuid())
  articleId Int
  playerId  String
  createdAt DateTime @default(now())
  body      String
  article   Article  @relation(fields: [articleId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])
}

enum ArticleCategory {
  basics
  advance
  site
  patch
  events
  news
  maintenance
  other
}

enum UserState {
  active
  disabled
  banned
}

/// Capability roles. A user holds a SET of these (`User.roles`) — they are not a ladder.
///
/// `admin` short-circuits every capability check (see server/auth/capabilities.ts); that is the only
/// implication between roles. `moderator` is orthogonal to `dev`/`tester`: it grants content/social
/// moderation and NO power over game state.
enum Role {
  admin
  moderator
  /// dev tools in any non-ranked match
  dev
  /// dev tools only in a custom match that enabled `testingTools` in its rules
  tester
}

model User {
  id            String    @id @default(cuid())
  state         UserState @default(active)
  roles         Role[]    @default([])
  /// Account handle. UNIQUE is load-bearing, not cosmetic: sign-in looks an account up by name, so
  /// two rows sharing one meant `findFirst` picked an arbitrary winner — registering a second
  /// account under someone's name either locked them out or, once row order shifted, handed their
  /// players to the impostor. Still nullable: OAuth sign-ups can arrive without one.
  name          String?   @unique
  password      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  identities    Player[]
  accounts      Account[]
  devToolAudits DevToolAudit[]
}

/// Failed sign-in / sign-up attempts, so the cost of guessing grows with every miss.
///
/// Persisted rather than in-memory because an in-process counter resets on every deploy and is
/// trivially outlasted — the DB record is what makes the backoff survive a restart. The in-memory
/// window limiter in `auth/throttle.ts` sits in front of this for burst traffic; this is the part
/// that remembers.
model AuthAttempt {
  /// What is being throttled: the lowercased account name for sign-in, `ip:<addr>` for sign-up.
  key         String    @id
  failures    Int       @default(0)
  /// Set once past the grace allowance; every further miss roughly doubles the wait.
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum CO {
  adder
}

enum Unit {
  pipeRunner
}

enum Game {
  advanceDatingByWeb
}

enum Achievement {
  fieldTrainingComplete
  winStreak
  underdog
  handicap
  lightningStrike
  destroyer
  fixer
  goldRush
  champion
  grizzledYet
}

model Clan {
  id          String   @id @default(cuid())
  name        String
  description String
  owner       Player   @relation("owner", fields: [ownerId], references: [id])
  ownerId     String
  members     Player[] @relation("member")
}

model Player {
  id          String        @id @default(cuid())
  name        String        @unique
  displayName String
  secret      Boolean       @default(false) // secret = true means that parent user is hidden on profile
  ChatMessage ChatMessage[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  Posts ArticleAuthors[]

  /// [PrismaPreferences]
  preferences  Json?
  achievements Achievement[]

  matches Match[]

  Notes Notes[]

  Comments   ArticleComment[]
  ownedClans Clan[]           @relation(name: "owner")
  clans      Clan[]           @relation(name: "member")

  // v2 lobby/match path (coexists with the v1 `matches` implicit relation above)
  matchPlayers     MatchPlayer[]
  matchStats       MatchPlayerStats[]
  lobbyMemberships PlayerInLobby[]

  // Ranked: hidden skill (never leaves the server) + the ladder the player actually sees.
  skills      PlayerSkill[]
  ranks       PlayerRank[]
  meritEvents MeritEvent[]
  hostedLobbies    Lobby[]            @relation(name: "lobbyHost")
  infractions      PlayerInfraction[]

  // Minimal social & communication linkages (queried explicitly on demand)
  sentFriendships      Friendship[]              @relation("sentFriendships")
  receivedFriendships  Friendship[]              @relation("receivedFriendships")
  ownedCategories      FriendCategory[]          @relation("ownedCategories")
  blockedUsers         Block[]                   @relation("blockedUsers")
  blockedByUsers       Block[]                   @relation("blockedByUsers")
  mutedUsers           Mute[]                    @relation("mutedUsers")
  mutedByUsers         Mute[]                    @relation("mutedByUsers")
  notifications        Notification[]            @relation("notifications")
  conversationsJoined  ConversationParticipant[]
  sentMessages         Message[]                 @relation("sentMessages")

  // Honor: medals awarded to opponents post-match (see Commendation).
  commendationsGiven    Commendation[] @relation("commendationsGiven")
  commendationsReceived Commendation[] @relation("commendationsReceived")
}

// Right now maps need to be immutable but we
// probably want to add revisions later on so that they can be "edited".
model WWMap {
  id   String @id @default(cuid())
  name String

  /// [PrismaTiles]
  tiles            Json
  /// [PrismaUnits]
  predeployedUnits Json
  numberOfPlayers  Int
  matches          Match[]
  lobbies          Lobby[]
  createdAt        DateTime @default(now())

  /// Modes this map may be played in at all. Seat count cannot decide this on its own: a 2v2 map
  /// and a free-for-all map both seat 4 but are designed around opposite assumptions (teammates
  /// adjacent vs. all four equidistant), so the legal modes are declared, not inferred.
  /// Empty means the map is not playable anywhere — treat that as unconfigured, not as a mode.
  supportedModes GameMode[]
  /// Modes this map is ranked-legal in — a subset of `supportedModes`. Deliberately per-mode
  /// rather than one boolean: a 4-player map can be fair enough for ranked free-for-all while
  /// being unbalanced for ranked 2v2, and a boolean would force banning both. Empty = casual only,
  /// which is the safe default for an imported or unvetted map: nothing reaches the rating ladder
  /// until someone opts it in.
  rankedModes    GameMode[]

  // TODO maps should have different sets of captureLimits and bannedUnitTypes
  // per league type.

  @@map("Map")
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  author   Player @relation(fields: [authorId], references: [id])
  authorId String

  match   Match?  @relation(fields: [matchId], references: [id]) // if no match, it's the public channel
  matchId String? @map("matchId")
}

enum MatchStatus {
  setup // general-picker round (timed CO selection; enemy COs hidden until reveal)
  playing
  finished
  cancelled // pick-phase abandoned / timed out with players unready
}

enum LobbyStatus {
  assembling // gathering players (custom invite or matchmaking)
  ready_check // AFK accept window (matchmaking only)
  map_ban // matchmaking map pick & ban (after both accept, before the Match spawns)
  map_reveal // winning map locked in; both players study it (~30s) before the CO pick
  cancelled // nobody joined / someone declined
  started // spawned its Match, lobby closed
}

enum LobbyMembership {
  invited // pending invite (custom lobby); accept -> active, reject -> row deleted
  active // joined the lobby
}

/// How many seats and how they're teamed. Values are identifiers, NOT display labels: Prisma enum
/// members can't start with a digit, so "1v1" is unspellable. The UI renders 1v1 / 2v2 / FFA.
enum GameMode {
  duel // 2 players           (UI: "1v1")
  teams // 4 players, 2v2      (UI: "2v2")
  ffa // 4 players, free-for-all (UI: "FFA")
}

/// The rules a queue plays under. Orthogonal to GameMode, and to `isRanked` — the third axis.
enum Ruleset {
  standard
  fog
  highFunds
  broken // no unit/CO bans
}

/// The military-rank ladder (plan §5.1). ORDER MATTERS — merit.ts indexes RANK_ORDER against this.
///
/// The whole ladder ships; `merit.ts ACTIVE_RANKS` gates which are reachable, and more switch on as
/// the playerbase grows — at a season rollover only, never mid-season. Sergeant/major/colonel are
/// dormant today, which is why this is a set rather than a ceiling: the ladder grows in the MIDDLE.
///
/// `general` is NOT here and never can be: it means Commanding Officer throughout this codebase
/// (schema.prisma:225 "general-picker round", :296 "enemy generals are hidden", :428 "chosen
/// general"). The apex is `marechal` — French, matching the MEDAILLE_MILITAIRE / CROIX_DE_GUERRE
/// decorations, ASCII in the enum and rendered "Maréchal". `cadet` rather than `recruit`, which is
/// honor's pre-Bronze tier.
enum Rank {
  cadet // placements — no divisions, no rank shown
  private
  sergeant //   dormant
  lieutenant
  captain
  major //   dormant
  colonel //   dormant
  marechal // apex — no divisions, merit unbounded
}

model Notes {
  content String
  public  Boolean @default(false)

  Player   Player @relation(fields: [playerId], references: [id])
  playerId String

  Match   Match  @relation(fields: [matchId], references: [id])
  matchId String

  @@id([playerId, matchId])
}

/// Per-player battle-report headline, computed ONCE at finalize (buildMatchStats + computeGrades)
/// and stored so the history list can show a grade without replaying the event log per row.
///
/// Deliberately NOT the whole `MatchStats`: the timeline (per-turn funds/army-value/properties) and
/// captureLog stay out — they're a time series, not a row, and only the full battle report needs
/// them. `endgame.summary` still replays for that; this table serves the list.
model MatchPlayerStats {
  match    Match  @relation(fields: [matchId], references: [id])
  matchId  String
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  /// computeGrades() — the S/A/B/C "match note", plus the three axes behind it (0..100).
  grade    String
  tactics  Int
  strength Int
  economy  Int

  /// Funds-value of enemy HP destroyed / own HP lost in combat.
  damageDealt Int
  damageTaken Int
  unitsKilled Int
  unitsLost   Int
  captures    Int
  /// Economy: funds spent building, and total income earned across the match.
  producedFunds Int
  incomeEarned  Int
  powersUsed    Int

  /// [PrismaUnitBreakdown] per-unit-type tallies (built / lost / damage-dealt) — the EG review's
  /// "by unit" sub-rows, already computed by buildMatchStats and kept here for career aggregation on
  /// the profile. Null for matches finalized before this was tracked (run the unit-stats backfill).
  unitBreakdown Json?

  @@id([matchId, playerId])
  @@index([playerId])
}

/// The HIDDEN skill rating — OpenSkill μ/σ. Keyed per MODE and POOLED across rulesets: fog / std /
/// high-funds duels all move one `duel` rating, because the playerbase is too small to shard it
/// (plan §1.3). Revisit with data (per-ruleset residuals vs predicted score), not opinion.
///
/// NEVER leaves the server. No router selects from this table: what a player sees is their rank +
/// Military Merit (`PlayerRank`). A number players can see is a number they play instead of the game.
///
/// Replaced the Elo `MMR` model — Elo had no uncertainty (so newcomers took ~25 games to place, and
/// stale ratings couldn't be told from fresh ones) and no way to rate teams or FFA.
model PlayerSkill {
  Player   Player   @relation(fields: [playerId], references: [id])
  playerId String
  mode     GameMode
  /// OpenSkill defaults. `ordinal()` (μ−3σ) of a fresh rating is exactly 0.
  mu       Float    @default(25.0)
  sigma    Float    @default(8.333333333333334)
  /// Rated games in this mode — for display ("4/10 placements"); the placement GATE is sigma.
  games    Int      @default(0)

  @@id([playerId, mode])
}

/// The military-rank ladder — the half a player actually sees. Cadet → Private → Lieutenant →
/// Captain → Maréchal (the full enum ships; ACTIVE_RANKS in merit.ts gates which are reachable).
///
/// Merit is STORED, not derived from skill: a rank that's a pure function of μ yo-yos and reads as
/// noise. It's nudged toward skill instead (merit.ts `convergence`).
///
/// Phase 6 (seasons) adds `seasonId` to this key and resets these rows at a rollover.
model PlayerRank {
  Player   Player   @relation(fields: [playerId], references: [id])
  playerId String
  mode     GameMode
  rank     Rank     @default(cadet)
  /// 5..1, 5 being the lowest. Meaningless for cadet (placements) and marechal (apex).
  division Int      @default(5)
  /// 0..99 within a division. Unbounded at marechal, so the top of the ladder still sorts.
  merit    Int      @default(0)
  peakRank Rank?
  /// Set by the admin visible-rank override: this rank is authoritative and must NOT be masked as
  /// "placements", even while the hidden skill estimate (sigma) is still provisional. Normal play
  /// leaves it false, so the placement gate governs everyone else exactly as before.
  placementsExempt Boolean @default(false)

  @@id([playerId, mode])
}

/// One match's Merit movement — the history list's Merit column, and an audit trail for the ladder.
/// Absent for casual matches (no row, not a zero).
model MeritEvent {
  match         Match    @relation(fields: [matchId], references: [id])
  matchId       String
  Player        Player   @relation(fields: [playerId], references: [id])
  playerId      String
  delta         Int
  rankAfter     Rank
  divisionAfter Int
  createdAt     DateTime @default(now())

  @@id([matchId, playerId])
  @@index([playerId, createdAt])
}

model Match {
  id String @id @default(cuid())

  /// Seat shape + rules, replacing the old flat `leagueType` (plan §3.1). `mode` was previously
  /// unreachable from a Match at all — it lived only on Lobby, and lobbyId is null for v1 matches,
  /// which is why the history list couldn't filter by it.
  ///
  /// Ranked-ness is the third axis and already exists below as `isRanked`.
  mode    GameMode
  ruleset Ruleset

  /// [PrismaMatchRules]
  rules  Json
  status MatchStatus

  /// Persisted match outcome (set once, when the game is decided). Null while playing.
  /// winnerTeamIndex is null on a draw even though the match is finished.
  winnerTeamIndex Int?
  /// How it ended: "elimination" | "day-limit" (GameOverReason in TS). Without it a day-limit draw
  /// and a mutual-elimination draw are the same row, so history can't tell them apart. Null for
  /// matches finished before this was tracked.
  endReason       String?
  finishedAt      DateTime?

  // --- v2 lobby/match path ---
  isRanked     Boolean   @default(false)
  /// [PrismaTeamFactions] cosmetic faction per team index (carried from the Lobby)
  teamFactions Json?
  /// general-picker deadline (setup status only); FE renders `pickEndsAt - now`
  pickEndsAt   DateTime?
  /// Turn-clock deadline for the player currently on turn (`now + their bank`), re-armed on every
  /// turn change. Null in an untimed match. Persisted because elapsed wall-clock cannot be replayed
  /// from the event log — without it a restart would hand the acting player a fresh full bank; the
  /// per-player banks themselves ARE event-derived and are not stored.
  turnEndsAt   DateTime?
  /// CO reveal gate: while null, enemy generals are hidden from queries/emits
  revealedAt   DateTime?
  /// set when MMR has been applied for this (ranked) match — idempotency guard for finalize
  ratedAt      DateTime?
  /// set when MatchPlayerStats has been written — the stats half of the finalize guard. Separate
  /// from `ratedAt` because stats are written for EVERY finished match, ranked or not.
  statsAt      DateTime?

  /// Day count + wall-clock length at finish, persisted so a history row needn't replay the event
  /// log to show them. Null while playing, and on finished rows that predate the backfill.
  /// This is what fixes `finishedRowToFrontend`'s hardcoded `turn: 0`.
  days       Int?
  durationMs Int?

  /// the Lobby this match was spawned from (v2 provenance; null for v1 matches)
  lobby   Lobby?  @relation(fields: [lobbyId], references: [id])
  lobbyId String? @unique

  map   WWMap  @relation(fields: [mapId], references: [id])
  mapId String

  /// [PrismaPlayerState] v1 durable player state — KEPT for the v1 game (transition period).
  /// New code must read `matchPlayers`, never this blob.
  playerState Json
  // playersConsentingToPublishChat Player[]

  /// v2 relational membership — the queryable durable store for the new match path
  matchPlayers MatchPlayer[]

  /// Per-player battle-report headline, written once at finalize (see MatchPlayerStats).
  playerStats MatchPlayerStats[]

  /// Merit movement this match caused — ranked matches only.
  meritEvents MeritEvent[]

  chatMessages ChatMessage[]
  chatIsPublic Boolean       @default(false)

  /// In-match chat channels (all + per-team), on the shared Conversation/Message system.
  conversations Conversation[]

  createdAt DateTime @default(now())
  Notes     Notes[]
  Event     Event[]
  Player    Player[]

  @@map("match")
}

model Event {
  match   Match  @relation(fields: [matchId], references: [id])
  matchId String

  /// The order of events within a match. Assigned by `appendEvent` (server/adapters/event-log.ts)
  /// as max+1 for THIS match — deliberately NOT a database default. It used to be
  /// `@default(autoincrement())`, but on Postgres that is a GLOBAL sequence: every insert drew a
  /// fresh globally-unique value, so the `@@id([matchId, index])` primary key below could never
  /// collide and the log had no write fence — two writers on one match would both succeed and
  /// silently interleave a divergent history. Deriving it per match makes that primary key the
  /// optimistic-concurrency check the log needs to survive a sharded/replicated game tier.
  /// Values are per-match ordered but NOT contiguous: rows predating this change keep their old
  /// global-sequence values, and each match simply continues from its own max. Only `orderBy` ever
  /// reads it, so the gaps are harmless.
  index Int @map("eventIndex")

  /// [PrismaEvent]
  content Json

  // at some point i considered removing the "index" field/column and using this createdAt
  // instead, but then it'd have to be part of the id and unique and
  // that will probably become awkward at some point.
  // so i decided to keep the index, even though createdAt *should*
  // in theory always be usable for processing events in order as well.
  // - Function

  createdAt DateTime @default(now())

  @@id([matchId, index])
}

// ─── v2 lobby / match path ──────────────────────────────────────────────────
// A Lobby is a PRE-ROOM that gathers players (custom invite or matchmaking) and runs the AFK
// ready-check. A Match is spawned only once players accept / the host starts. The Match's `setup`
// status is the general-picker round. See .ai/plans/lobby-backend-plan.md.

model Lobby {
  id           String     @id @default(cuid())
  host         Player?    @relation(name: "lobbyHost", fields: [hostPlayerId], references: [id])
  hostPlayerId String? // set for custom lobbies; null for matchmaking
  isRanked     Boolean    @default(false)
  /// Drives team count + slots. Cast in place from the old free-text "1v1"/"2v2"/"ffa4" by
  /// utils/phase1-league-backfill.sql — `db push` can't express the USING clause and would have
  /// dropped the column instead.
  mode         GameMode
  ruleset      Ruleset

  /// [PrismaMatchRules] MatchRules draft (fog, funds, pickSeconds, teamMapping…)
  rules Json

  map   WWMap?  @relation(fields: [mapId], references: [id])
  mapId String? // host-chosen; matchmaking assigns

  /// [PrismaTeamFactions] random AW faction per team index (cosmetic)
  teamFactions Json?

  status      LobbyStatus @default(assembling)
  readyEndsAt DateTime? // AFK ready-check deadline (matchmaking, ~30s)

  // --- matchmaking map pick & ban (status = map_ban) ---
  readyCheckLenient Boolean @default(false) // wide MMR gap: longer window + no sanction on decline
  /// How lopsided the pairing was, in percentage points away from an even 50/50 (0..50) — e.g. 18
  /// means the favourite had ~68% odds. Audit/display only.
  ///
  /// A GAP, not a rating: the hidden μ/σ never leaves the server, and a relative gap doesn't
  /// reconstruct it. Replaced `mmrDiff`, which was an Elo distance and became meaningless when
  /// fairness stopped being expressible as one (a fixed μ gap means different things at different σ
  /// — see .ai/plans/ranked-ladder-plan.md §4.1).
  fairnessGap       Int?
  /// [PrismaMapPool] candidate WWMap ids for the ban phase (mapId stays null until the roll)
  mapPool           Json?
  mapPhaseEndsAt    DateTime? // map pick & ban deadline (mirrors readyEndsAt)

  /// the Match spawned from this lobby (back-relation; FK lives on Match.lobbyId)
  match Match?

  createdAt DateTime        @default(now())
  members   PlayerInLobby[]
}

model PlayerInLobby {
  id       String @id @default(cuid())
  lobby    Lobby  @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  lobbyId  String
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  membership  LobbyMembership @default(active) // invited = pending; accept -> active, reject -> delete
  team        Int? // self-assigned team index (null = unassigned bench)
  slot        Int? // slot within team (or overall for FFA)
  isSpectator Boolean         @default(false) // FFA overflow / explicit spectator
  accepted    Boolean         @default(false) // AFK ready-check accepted (matchmaking only)

  // --- matchmaking map pick & ban ---
  /// [PrismaBannedMapIds] this player's banned WWMap ids (2 in 1v1)
  bannedMapIds Json?
  votedMapId   String? // this player's single map vote (must be a non-banned pool member)

  joinedAt    DateTime        @default(now())

  @@unique([lobbyId, playerId])
  @@index([playerId])
}

// Relational per-player match facts (the v2 durable store). Named MatchPlayer to avoid clashing
// with the v1 runtime `PlayerInMatch` type (shared/types/server-match-state), which is kept.
model MatchPlayer {
  id       String @id @default(cuid())
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId  String
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  slot Int
  team Int // authoritative team; rules.teamMapping is derived from this at spawn
  army String // faction colour (Army enum lives in TS/zod, not Prisma)

  /// [PrismaCoId] chosen general — null until picked; hidden from enemies until Match.revealedAt
  coId Json?

  ready       Boolean @default(false) // CO locked in during the setup/picker round
  isSpectator Boolean @default(false)

  /// [PrismaPlayerSkins] per-match cosmetic override; defaults from Player.preferences.skins
  skins Json?

  result    String? // "won" | "lost" | "drawn" (set at finalize)
  createdAt DateTime @default(now())

  @@unique([matchId, playerId])
  @@index([playerId]) // fast "player X's matches", W/L, CO usage
}

// Durable, cross-cutting behaviour log for long-term moderation + sanctions (not just leavers).
model PlayerInfraction {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  type     String // "afk_ingame" | "missed_ready_check" | "abandoned_map_ban" | "abandoned_pick" | "left_lobby" | "chat_harassment" | …
  severity Int     @default(1) // weight for sanction thresholds
  matchId  String? // context when applicable
  lobbyId  String?
  detail   Json? // freeform (e.g. turns missed, message id)

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([playerId, type])
  @@index([playerId, createdAt])
}

// ─── Game reference data (DB source of truth) ───────────────────────────────
// All game vocabulary + stats live here, managed by SQL. The engine never imports @prisma/client;
// a boot adapter loads these into a synchronous in-memory `gameData` cache the engine reads, and a
// `/api/gameData` endpoint ships the same payload to the v1 client-side engine.
// See .ai/plans/game-data-in-db-plan.md. Seeded bit-identically from the current code constants.

// ---- Units ----
model UnitGroup {
  id          String     @id @default(cuid())
  key         String     @unique // "infantry" | "directVehicle" | "indirect" | "air" | "sea"
  displayName String
  units       UnitType[] // many-to-many: a unit can be in several groups (battleship = indirect + sea)
}

model UnitType {
  id          String      @id @default(cuid())
  key         String      @unique // "infantry", "mdTank", …
  displayName String
  groups      UnitGroup[] // a unit belongs to every group whose predicate it matches

  facility       String // "base" | "airport" | "port"
  movementType   String // "foot" | "boots" | "tires" | "treads" | "air" | "sea" | "lander" | "pipe"
  movementPoints Int
  vision         Int
  fuel           Int
  ammo           Int? // null = no primary weapon ammo
  cost           Int
  attackRangeMin Int? // null = cannot attack (e.g. APC)
  attackRangeMax Int?

  coModifiers CoModifier[] // per-unit override rows target this
}

// ---- Terrain & properties ----
model TerrainKind {
  id            String                @id @default(cuid())
  key           String                @unique // "plain","road","woods","mountain","sea","river",…
  displayName   String
  defenseStars  Int
  isProperty    Boolean               @default(false)
  movementCosts TerrainMovementCost[]
  property      Property?
}

model TerrainMovementCost {
  id           String      @id @default(cuid())
  terrain      TerrainKind @relation(fields: [terrainId], references: [id], onDelete: Cascade)
  terrainId    String
  movementType String
  cost         Int? // null = impassable

  @@unique([terrainId, movementType])
}

model Property {
  id              String      @id @default(cuid())
  terrain         TerrainKind @relation(fields: [terrainId], references: [id])
  terrainId       String      @unique
  key             String      @unique // "hq","city","base","airport","port","commtower","lab"
  fundsPerTurn    Int
  repairsFacility String? // which facility's units it repairs
  buildsFacility  String? // which facility it produces
  vision          Int         @default(0)
}

// ---- Commanders ----
model Co {
  id          String    @id @default(cuid())
  key         String // "max"
  gameVersion String // "AW1" | "AW2" | "AWDS"
  displayName String
  phases      CoPhase[]

  @@unique([key, gameVersion])
}

model CoPhase {
  id    String @id @default(cuid())
  co    Co     @relation(fields: [coId], references: [id], onDelete: Cascade)
  coId  String
  phase String // "dayToDay" | "coPower" | "superCoPower"

  name        String? // power name (null for dayToDay)
  stars       Float? // power cost (null for dayToDay; fractional for AW1, e.g. Sami 2.5)
  description String
  luckGood    Int? // luck roll bonus (Nell/Rachel/Flak/Jugger)
  luckBad     Int?
  // The power's own activation animation (AW-style cutscene). Owned by the power, not its effects.
  visualKey String? // "missile" | "meteor" | "blast" | "healWave" | …

  modifiers CoModifier[]
  effects   CoPhaseEffect[]

  @@unique([coId, phase])
}

// "general modification over units" — group-level rows, with optional per-unit override.
model CoModifier {
  id           String    @id @default(cuid())
  phase        CoPhase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  phaseId      String
  // Exactly one target: a group, or a specific unit (override).
  unitGroupKey String? // references UnitGroup.key
  unitType     UnitType? @relation(fields: [unitTypeId], references: [id])
  unitTypeId   String?

  attackPct     Int? // firepower % delta (+20, -10)
  defensePct    Int?
  rangeDelta    Int?
  movementDelta Int?
  visionDelta   Int?
  buildCostPct  Int?
  terrainStarsPct Int? // reserved: scale terrain stars by a percent
  terrainStarsDelta Int? // Drake: flat +N terrain stars on the defender's own units
  terrainStarsMult  Int? // Lash SCOP: multiply the defender's terrain stars (×2)
  // Sturm-style: flat movement cost on every terrain (overrides per-terrain cost).
  movementCostAll Int?

  // Conditional application (null/false = always).
  onTerrainKey String? // Jake = "plain", Koal = "road"
  onProperty   Boolean @default(false) // Kindle
  onWeather    String? // Olaf AWDS = "snow"
  notWeather   String? // Sturm/Lash all-terrain-cost-1 = NOT "snow"
  onFacility   String? // Eagle/Sensei/Drake target by build facility ("airport" | "port" | "base")
  facilityNot  String? // Lash firepower skips "airport" units
  requiresWeapon Boolean @default(false) // Max movement bonus excludes transports (no attackRange)
  vsGroup      String? // opponent condition: Javier defence vs "indirect" attackers

  // Scaling by an injectable runtime variable: the stat gains floor(variable / scaleDivisor) *
  // scaleFactor percent. Colin SCOP = {scaleStat:"attack", scaleVariable:"funds", scaleDivisor:300,
  // scaleFactor:1}; Javier = {scaleStat:"defense", scaleVariable:"commtowerBoost", scaleFactor:1..3}.
  scaleStat     String? // "attack" | "defense"
  scaleVariable String? // "funds" | "commtowerBoost" | "terrainStars" | "ownedProperties"
  scaleDivisor  Int?
  scaleFactor   Int?

  @@index([phaseId])
}

// Typed non-stat / exotic effects (heal, funds, AoE, hide-HP, resupply, missiles…).
model CoPhaseEffect {
  id      String  @id @default(cuid())
  phase   CoPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  phaseId String
  kind    String // "heal" | "funds" | "aoeDamage" | "hideHp" | "resupply" | …
  params  Json? // kind-specific payload the engine interprets

  @@index([phaseId])
}

// ---- Skins (asset resolution) ----
model SkinType {
  id    String @id @default(cuid())
  key   String @unique // "map" | "army" | "camp" | "co"
  skins Skin[]
}

model Skin {
  id          String      @id @default(cuid())
  type        SkinType    @relation(fields: [typeId], references: [id])
  typeId      String
  key         String // "aw2","ds","orange-star",…
  displayName String
  group       String? // optional grouping
  assets      SkinAsset[]

  @@unique([typeId, key])
}

model SkinAsset {
  id         String @id @default(cuid())
  skin       Skin   @relation(fields: [skinId], references: [id], onDelete: Cascade)
  skinId     String
  elementKey String // "infantry-0","tile-city","hq","portrait"
  path       String // "/img/units/orangeStar/Infantry-0.png"

  @@unique([skinId, elementKey])
}

// 2. move/map data structures
// 3. tiers in general, map/league tiers?

// ─── SOCIAL, NOTIFICATION & UNIFIED CONVERSATION SUBSYSTEM ───────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ConversationKind {
  DM
  GROUP
  LOBBY
  MATCH
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPT
  LOBBY_INVITE
  SYSTEM
}

model Friendship {
  id          String           @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sender      Player           @relation("sentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    Player           @relation("receivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)
  categories  FriendCategory[] @relation("CategoryFriendships")

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model FriendCategory {
  id          String       @id @default(cuid())
  name        String       // e.g. "Family", "In-Game Friends", "Scrim Partners"
  ownerId     String
  createdAt   DateTime     @default(now())

  owner       Player       @relation("ownedCategories", fields: [ownerId], references: [id], onDelete: Cascade)
  friendships Friendship[] @relation("CategoryFriendships")

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Block {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  createdAt   DateTime @default(now())

  blocker     Player   @relation("blockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     Player   @relation("blockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model Mute {
  id          String   @id @default(cuid())
  muterId     String
  mutedId     String
  createdAt   DateTime @default(now())

  muter       Player   @relation("mutedUsers", fields: [muterId], references: [id], onDelete: Cascade)
  muted       Player   @relation("mutedByUsers", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
}

model Notification {
  id          String           @id @default(cuid())
  playerId    String
  type        NotificationType
  content     String           @db.Text // JSON string containing custom payloads (senderName, lobbyId, etc.)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  player      Player           @relation("notifications", fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, isRead, createdAt(desc)])
}

model Conversation {
  id          String                    @id @default(cuid())
  name        String?                   // Display name (null for DMs, custom name for Groups)
  kind        ConversationKind
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  // In-match channel linkage (null for DMs/groups). teamIndex: -1 = whole-match "All" channel,
  // >= 0 = that team's team-only channel. The (matchId, teamIndex) pair uniquely identifies a
  // match channel so it can be get-or-created idempotently.
  match     Match?  @relation(fields: [matchId], references: [id])
  matchId   String?
  teamIndex Int?

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([matchId, teamIndex])
  @@index([kind, updatedAt]) // Excellent for automated cleanup runs on old LOBBY/MATCH kinds
}

model ConversationParticipant {
  conversationId String
  playerId       String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now()) // Keeps track of participant's view cursor

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([conversationId, playerId])
  @@index([playerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  editedAt       DateTime? // Set when a player modifies their message
  deletedAt      DateTime? // Soft-delete timestamp (hidden in standard queries)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Player       @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── HONOR ───────────────────────────────────────────────────────────────────
// Post-match "commendations": a player awards ONE medal to a single opponent (matchmaking games
// only, enforced in the usecase). Tier + star sub-rank + overall Prestige are DERIVED from the
// per-medal counts at read time (see src/server/honor) — not stored. Ranking (military chevrons) is
// a separate system (MMR); honor is prestige, never chevrons. See .ai/plans/end-game-screen-plan.md.

enum MedalType {
  GOOD_CONDUCT // 👏 sportsmanship
  MEDAILLE_MILITAIRE // 🤝 well played
  CROIX_DE_GUERRE // ⚔️ worthy foe
}

model Commendation {
  id      String @id @default(cuid())
  matchId String

  fromPlayer Player @relation("commendationsGiven", fields: [fromId], references: [id], onDelete: Cascade)
  fromId     String
  toPlayer   Player @relation("commendationsReceived", fields: [toId], references: [id], onDelete: Cascade)
  toId       String

  medal     MedalType
  createdAt DateTime  @default(now())

  @@unique([matchId, fromId]) // one medal awarded per giver per match
  @@index([toId, medal]) // per-medal tallies for tier + prestige
}

// ─── Dev / admin tooling ────────────────────────────────────────────────────

/// Security record of every privileged-tool use (dev, tester AND admin — no exemption).
///
/// This is deliberately NOT the in-match record: the tool's effect is an `Event` row, which is what
/// replays into match state and what both players see. This table answers a different question —
/// "who really did this, from where" — and must outlive the match.
///
/// Keyed on `userId` rather than `playerId` on purpose: a User owns many Players, and the threat
/// this guards against is a stolen/impersonated account, which is a User-level event. `playerId` is
/// kept alongside for in-match correlation but is nullable (admin tools aren't always match-scoped).
model DevToolAudit {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  /// null for tools that aren't scoped to a single match (e.g. modify rank)
  matchId  String?
  playerId String?

  /// the capability that authorised this call, as evaluated at call time
  capability String
  /// tool name, e.g. "addFunds" / "forceOutcome"
  tool String
  /// the validated action payload
  payload Json

  /// impersonation forensics — a stolen admin session usually shows up as a new origin
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([matchId])
}
