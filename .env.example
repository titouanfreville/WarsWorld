# .env setup instructions:
# 1. Copy this ".env.example" file to ".env"
# 2. Fill out the PGPASSWORD and NEXTAUTH_SECRET fields with random passwords

# Use secure, random string (https://passwordsgenerator.net/)
# This is the password that Docker will use to create the PostgreSQL container.
PGPASSWORD="abc"

# Use secure, random string (https://passwordsgenerator.net/)
# Documentation: https://next-auth.js.org/configuration/options#nextauth_secret
NEXTAUTH_SECRET="GarHVfuE4GhEdB7A6MuFzFc7O8OuH7KjOmNpNHYGX4Q"
AUTH_SECRET="GarHVfuE4GhEdB7A6MuFzFc7O8OuH7KjOmNpNHYGX4Q"
# In order to use accounts on WarsWorld, you will need an OAuth API Key
# Directions are in the readme. You can ignore these if you don't plan on using accounts

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

######### You shouldn't have to edit anything below this line for development. #####################
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:${PGPASSWORD}@localhost:5932/trpc-starter-websockets?schema=public"

# ── Production (Supabase) ──────────────────────────────────────────────────────────────────────
# Supabase runs Postgres 17; this local Docker DB is postgres:13. CI deliberately tests against 17
# to match production — if you hit a migration that behaves differently, that mismatch is why.
#
# Pick the connection mode deliberately, because it decides whether migrations work:
#   • Direct (db.<ref>.supabase.co:5432)          — best fit for us. We run ONE long-lived server
#     process holding a small pool, so a pooler buys nothing. Note Supabase direct connections are
#     IPv6-only unless you buy the IPv4 add-on (Fly.io has IPv6 egress, so this works there).
#   • Session pooler (…pooler.supabase.com:5432)  — safe fallback; works for migrations too.
#   • Transaction pooler (…pooler.supabase.com:6543) — do NOT point DATABASE_URL here for
#     migrations: it needs `?pgbouncer=true` and cannot run DDL. If you ever need it for the app,
#     add a separate `directUrl` for migrations rather than pointing this at 6543.
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Scratch DB used ONLY to generate and verify migrations (see "Schema changes" in CLAUDE.md).
# Prisma replays the entire migration history into it, compares, and drops it again — so never
# point this at a database holding real data. Create it once with `npm run prisma:shadow-init`.
# Not needed in production: `prisma migrate deploy` never touches it.
SHADOW_DATABASE_URL="postgresql://postgres:${PGPASSWORD}@localhost:5932/warsworld-shadow?schema=public"

NODE_ENV="production"

# The browser origin allowed to make credentialed requests to the production server
# (src/server/main-production.ts). Locally the Next dev server and the WS/API server are on
# different ports, which is the only reason this exists — in production they are one process on one
# origin, so set this to the deployed site URL. Unset falls back to http://localhost:3000 with a
# warning, which will reject every real browser request once deployed.
CORS_ORIGIN="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXTAUTH_URL="http://localhost:3000/api/auth"

# Log verbosity. One of: debug | info | warn | error | silent.
# Defaults to "warn" when NODE_ENV=production, "debug" otherwise — so prod stays quiet by default.
# LOG_LEVEL controls server + engine logs; NEXT_PUBLIC_LOG_LEVEL controls browser logs.
# LOG_LEVEL="info"
# NEXT_PUBLIC_LOG_LEVEL="warn"

# Dev/admin tools: allow them in RANKED matches. Defaults to false — leave it unset in production.
#
# This is the ONLY way past the ranked block: no role can override it, not even admin, so a stolen
# staff account still can't touch the ladder on a deployment where this is off. Turning it on means
# dev tools AND admin force-outcome can move real MMR, so it's for local/dev or deliberate hard
# testing only. Read once at boot — restart the server after changing it.
# DEV_TOOLS_ALLOW_RANKED="true"
