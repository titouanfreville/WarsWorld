# Copy to `.env.production` on the VPS and fill in. Used by:
#   docker compose -f docker-compose.prod.yml --env-file .env.production pull && ... up -d
#
# NOTE: `.env.production` is gitignored. Never commit the filled-in version.

# ── Image (built by CI, pulled here) ───────────────────────────────────────────────────────────
# The ghcr.io ref the publish workflow pushes. `latest` tracks main; pin a `sha-<short>` tag to
# freeze a known-good build. Public image ⇒ no `docker login` needed on the VPS.
APP_IMAGE="ghcr.io/<owner>/warsworld:latest"

# ── Database (runs in the compose stack, not exposed to the internet) ──────────────────────────
POSTGRES_USER="warsworld"
POSTGRES_DB="warsworld"
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=""

# ── Public identity ───────────────────────────────────────────────────────────────────────────
# The hostname Caddy gets a TLS certificate for. DNS must already point here.
SITE_DOMAIN="warsworld.example.com"

# Browser origin allowed to make credentialed requests. Must match SITE_DOMAIN exactly.
# If unset the server falls back to http://localhost:3000 and rejects every real request.
CORS_ORIGIN="https://warsworld.example.com"

# NOTE: NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_WS_URL are NOT here. They are inlined into the client
# bundle at BUILD time, so they live as repository VARIABLES on the CI publish workflow
# (Settings → Secrets and variables → Actions → Variables), not in this runtime env file. Changing
# the public domain means updating those variables and re-running the workflow to rebuild the image.

# ── Auth ──────────────────────────────────────────────────────────────────────────────────────
# Generate fresh values: openssl rand -base64 32
# NEVER reuse the placeholder secrets from .env.example — they are public.
NEXTAUTH_SECRET=""
AUTH_SECRET=""
NEXTAUTH_URL="https://warsworld.example.com/api/auth"

# ── Operational ───────────────────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL="warn"

# Nightly dumps to ./backups, keeping this many.
BACKUP_KEEP="14"
BACKUP_INTERVAL_SECONDS="86400"

# ── Deliberately absent ───────────────────────────────────────────────────────────────────────
# SHADOW_DATABASE_URL     — migration tooling only, never needed by a deployment.
# DEV_TOOLS_ALLOW_RANKED  — leave unset. Setting it lets dev/admin tools move real MMR.
